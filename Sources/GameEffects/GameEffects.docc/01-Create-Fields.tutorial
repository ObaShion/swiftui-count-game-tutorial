@Tutorial(time: 10) {
    @Intro(title: "赤と青のフィールドを作ろう！") {
        今のゲームはもう遊べる状態だよ！ まずは青・中央・赤の場所がひと目で分かる画面へ変えてみよう！
    }

    @Section(title: "フィールドと中央カードを整えよう！") {
        @ContentAndMedia {
            この教材では、上が青、真ん中が残りの数、下が赤になっているコードから始めるよ。上下の `VStack` に背景色を付けて、残りの数は白いカードのように見せよう！
        }

        @Steps {
            @Step {
                まずは `ContentView.swift` 全体を見て、いまの位置を確認しよう。青・真ん中・赤のコードを省略せずに載せているので、どこへ書くか分かるよ！

                @Code(name: "ContentView.swift", file: "00-StartingPoint.swift", reset: true)
            }
            @Step {
                まずは上半分だけ！ 青側の `VStack` に余白と青いグラデーションを追加しよう。

                @Code(name: "青いフィールド", file: "01-BlueField.swift", reset: true)
            }
            @Step {
                次は真ん中だけ！ 結果と残りの数を、大きな白いカードにまとめよう。

                @Code(name: "中央のカード", file: "01-CountCard.swift", reset: true)
            }
            @Step {
                最後に下半分だけ！ 赤側にも同じ余白とグラデーションを追加しよう。

                @Code(name: "赤いフィールド", file: "01-RedField.swift", reset: true)
            }
            @Step {
                3つのブロックを入れたあとの `ContentView.swift` 全体だよ。上下の位置もここで確認しよう！

                @Code(name: "ContentView.swift（ここまでの完成形）", file: "01-Layout.swift", reset: true) {
                    @Image(source: "preview-01-layout.png", alt: "上半分が青、中央が白い数字カード、下半分が赤になった数取りゲーム")
                }
            }
        }
    }
}
