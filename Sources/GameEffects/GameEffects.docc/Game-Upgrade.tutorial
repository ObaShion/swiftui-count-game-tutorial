@Tutorial(time: 60) {
    @Intro(title: "数取りゲームをレベルアップ") {
        画面を赤・青に分け、押しやすいボタン、特殊ワザ、音と演出を追加します。
    }

    @Section(title: "ゲームを理解して画面を整える") {
        @ContentAndMedia {
            まず、画面が覚えている値を確認し、赤と青のフィールドを作ります。
        }

        @Steps {
            @Step {
                [第1章：ゲームの「今」を覚えさせよう](../../../documentation/gameeffects/01-game-state/)
            }
            @Step {
                [第2章：赤と青のフィールドを作ろう](../../../documentation/gameeffects/02-split-background/)
            }
        }
    }

    @Section(title: "ゲームのルールと演出を追加する") {
        @ContentAndMedia {
            分かりやすいボタン、1回だけ使える5個取り、音とエフェクトを順に追加します。
        }

        @Steps {
            @Step {
                [第3章：押したくなるボタンにしよう](../../../documentation/gameeffects/03-game-buttons/)
            }
            @Step {
                [第4章：1回だけ使えるスペシャルワザ](../../../documentation/gameeffects/04-special-button/)
            }
            @Step {
                [第5章：音とエフェクトを付けよう](../../../documentation/gameeffects/05-sound-and-effects/)
            }
            @Step {
                [第6章：もう一度遊べるようにしよう](../../../documentation/gameeffects/06-reset-and-extensions/)
            }
        }
    }
}
