@Tutorial(time: 10) {
    @Intro(title: "ボタンをゲームらしくしよう！") {
        数字を大きくして、押せるボタンと押せないボタンがすぐ分かるようにするよ！
    }

    @Section(title: "大きくて押しやすいボタンを作ろう！") {
        @ContentAndMedia {
            `1`、`2`、`3` を大きく見せて、その下に「とる」と表示しよう！
        }

        @Steps {
            @Step {
                まず、数字と「とる」をまとめた共通デザインを作ろう！ これを6個のボタンから呼び出すよ。

                @Code(name: "ボタンの見た目", file: "02-MoveLabel.swift", reset: true)
            }
            @Step {
                青側の3個だけを置き換えよう！ 残りが足りないボタンは自動で押せなくなるよ。

                @Code(name: "青側のボタン", file: "02-BlueButtons.swift", reset: true)
            }
            @Step {
                同じ形で赤側の3個も置き換えよう！ `isBlue` と色が `false`、`.red` になるところに注目してね。

                @Code(name: "赤側のボタン", file: "02-RedButtons.swift", reset: true)
            }
            @Step {
                6個を入れたあとの全体を確認しよう！ Previewにも新しいボタンが表示されるよ。

                @Code(name: "ContentView.swift（ここまでの完成形）", file: "02-Buttons.swift", reset: true) {
                    @Image(source: "preview-02-buttons.png", alt: "青と赤のフィールドに1、2、3の大きなゲームボタンが並んだ画面")
                }
            }
        }
    }
}
